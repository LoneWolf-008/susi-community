# Salin menjadi frontend/.env.local bila perlu. Semua variabel VITE_* ikut ter-bundle
# ke browser, jadi JANGAN pernah menaruh secret (API key, password) di sini.

# Basis URL API backend. Biarkan kosong saat dev (dipakai mulai T4: Vite mem-proxy
# /api ke http://localhost:3009). Isi saat produksi bila backend beda domain, contoh:
#   VITE_API_URL=https://susi-api.up.railway.app/api
VITE_API_URL=
