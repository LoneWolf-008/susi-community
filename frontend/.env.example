# Salin menjadi frontend/.env.local bila perlu. Semua variabel VITE_* ikut ter-bundle
# ke browser, jadi JANGAN pernah menaruh secret (API key, password) di sini.

# Basis URL API backend. Biarkan kosong saat dev: Vite mem-proxy /api ke backend lokal.
# Isi saat produksi bila backend beda domain, contoh:
#   VITE_API_URL=https://susi-api.up.railway.app/api
VITE_API_URL=

# Target proxy /api saat `npm run dev` / `npm run preview` (bukan untuk produksi).
VITE_DEV_API_TARGET=http://localhost:3009
