# Salin menjadi backend/.env lalu lengkapi nilainya. Jangan commit backend/.env.
# Variabel bertanda [wajib] dicek saat start; server berhenti dengan pesan jelas bila kosong.

# ===== Server =====
PORT=3009
NODE_ENV=development
# Jumlah proxy di depan server (Railway/Render = 1). Nilai lain: true/false/loopback.
TRUST_PROXY=1

# ===== Database MySQL / MariaDB ===== [wajib, kecuali DB_PASSWORD]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Boleh kosong untuk MySQL lokal (Laragon/XAMPP); wajib diisi di production.
DB_PASSWORD=
DB_NAME=susi_community_db

# ===== JWT ===== [wajib]
# Harus berbeda satu sama lain; minimal 32 karakter di production. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===== CORS ===== [wajib]
# Origin frontend (port default Vite). Pisahkan dengan koma bila lebih dari satu.
FRONTEND_URL=http://localhost:5173

# ===== Rate limit (per IP) =====
# Semua /api per 15 menit.
RATE_LIMIT_MAX=500
# Login (hanya percobaan gagal) dan registrasi per jendela waktu.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Endpoint publik /api/public/* per menit, dan POST /api/public/visit per 15 menit.
PUBLIC_RATE_LIMIT_MAX=60
VISIT_RATE_LIMIT_MAX=10

# ===== Unggahan =====
# Folder unggahan, relatif terhadap folder backend. Arahkan ke volume persisten saat deploy.
UPLOAD_DIR=uploads

# ===== Chatbot "Tanya SUSI" (opsional) =====
# Tanpa key, chatbot tetap menjawab dari basis pengetahuan (KB). Key HANYA di file ini:
# tidak pernah dikirim ke frontend dan tidak pernah dicatat ke log. Set batas kredit pada key
# di dashboard OpenRouter.
# openrouter = OpenRouter sungguhan · mock = jawaban tiruan untuk dev/test tanpa key & biaya.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Slug model OpenRouter (https://openrouter.ai/models). Cadangan dipisah koma, dicoba berurutan
# bila model utama gagal/dibatasi (dikirim sebagai `models`).
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_FALLBACK_MODELS=
# Batas waktu per permintaan (stream: jeda maksimal antar-chunk), ms.
OPENROUTER_TIMEOUT_MS=12000
# Atribusi aplikasi di OpenRouter (opsional): URL situs & nama aplikasi.
OPENROUTER_REFERER=
OPENROUTER_TITLE=SUSI Community
# deny = hanya provider yang tidak menyimpan/melatih dengan isi chat (disarankan). allow = semua provider.
OPENROUTER_DATA_COLLECTION=deny
# Kosongkan untuk Haiku 4.5. Untuk model yang berpikir dulu: none|minimal|low|medium|high.
OPENROUTER_REASONING_EFFORT=
# Batas token jawaban. Anggaran LLM per hari (USD): bila habis, chatbot turun ke mode KB-saja
# (tetap menjawab dari panduan) sampai hari berganti. 0 = LLM dimatikan.
CHATBOT_MAX_TOKENS=350
CHATBOT_DAILY_BUDGET_USD=1
# Cache jawaban LLM di memori (jam; 0 = mati) dan jumlah entri maksimal.
CHATBOT_CACHE_TTL_HOURS=6
CHATBOT_CACHE_MAX=500
# Rate limit chatbot per menit: pengguna (per akun), anonim (per IP + sesi chat), anonim (per IP).
CHATBOT_RATE_LIMIT_PER_MIN=12
CHATBOT_ANON_RATE_LIMIT_PER_MIN=6
CHATBOT_ANON_IP_RATE_LIMIT_PER_MIN=30
# Batas pesan per hari: pengguna (per akun), anonim (per sesi chat), anonim (per IP).
# Satu IP bisa dipakai banyak orang (Wi-Fi sekolah/venue): naikkan plafon IP untuk demo ramai.
CHATBOT_DAILY_LIMIT_USER=100
CHATBOT_DAILY_LIMIT_ANON=20
CHATBOT_DAILY_LIMIT_ANON_IP=300
# Domain tambahan yang boleh muncul sebagai tautan di jawaban, dipisah koma (host FRONTEND_URL dan
# wa.me selalu boleh). Tautan lain dihapus dari jawaban LLM.
CHATBOT_ALLOWED_DOMAINS=
# Eskalasi ke AgenSUSI: skor sinyal minimal untuk menyarankan tombol "Hubungi AgenSUSI".
CHATBOT_ESCALATION_THRESHOLD=50
# Jam layanan AgenSUSI (HH:MM-HH:MM, kosong = setiap saat) & zona waktunya. Di luar jam layanan
# tiket tetap dibuat dan pengguna diarahkan ke WhatsApp resmi.
CHATBOT_SERVICE_HOURS=
CHATBOT_SERVICE_TZ=Asia/Jakarta
# Jalur murah: pertanyaan yang tercakup penuh satu entri KB dijawab langsung tanpa LLM. false hanya
# untuk evaluasi prompt/model (npm run eval:chatbot -- --no-kb-direct).
CHATBOT_KB_DIRECT=true
# Retensi riwayat chat (hari): isi pesan dihapus & pertanyaan di ask_logs dianonimkan setelah sekian
# hari (job harian di server, atau `npm run chat:retention`). 0 = retensi dimatikan.
CHATBOT_RETENTION_DAYS=90

# ===== Sertifikasi talenta (U5) =====
# Jumlah proyek COMPLETED minimal agar talenta bisa mengajukan sertifikasi.
CERT_MIN_PROJECTS=3

# ===== Seed data demo (hanya dibaca `npm run seed`, tidak oleh server) =====
# Akun admin. Password minimal 10 karakter.
ADMIN_EMAIL=admin@susi.test
ADMIN_PASSWORD=
# Password untuk semua akun demo lain (liaison, requester, talenta). Minimal 10 karakter.
SEED_USER_PASSWORD=
