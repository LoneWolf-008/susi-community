# Salin menjadi backend/.env lalu lengkapi nilainya. Jangan commit backend/.env.
# Variabel bertanda [wajib] dicek saat start; server berhenti dengan pesan jelas bila kosong.

# ===== Server =====
PORT=3009
NODE_ENV=development
# Jumlah proxy di depan server (Railway/Render = 1). Nilai lain: true/false/loopback.
TRUST_PROXY=1

# ===== Database MySQL / MariaDB ===== [wajib, kecuali DB_PASSWORD]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Boleh kosong untuk MySQL lokal (Laragon/XAMPP); wajib diisi di production.
DB_PASSWORD=
DB_NAME=susi_community_db

# ===== JWT ===== [wajib]
# Harus berbeda satu sama lain; minimal 32 karakter di production. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===== CORS ===== [wajib]
# Origin frontend (port default Vite). Pisahkan dengan koma bila lebih dari satu.
FRONTEND_URL=http://localhost:5173

# ===== Rate limit (per IP) =====
# Semua /api per 15 menit.
RATE_LIMIT_MAX=500
# Login (hanya percobaan gagal) dan registrasi per jendela waktu.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Endpoint publik /api/public/* per menit, dan POST /api/public/visit per 15 menit.
PUBLIC_RATE_LIMIT_MAX=60
VISIT_RATE_LIMIT_MAX=10

# ===== Unggahan =====
# Folder unggahan, relatif terhadap folder backend. Arahkan ke volume persisten saat deploy.
UPLOAD_DIR=uploads

# ===== Seed data demo (hanya dibaca `npm run seed`, tidak oleh server) =====
# Akun admin. Password minimal 10 karakter.
ADMIN_EMAIL=admin@susi.test
ADMIN_PASSWORD=
# Password untuk semua akun demo lain (liaison, requester, talenta). Minimal 10 karakter.
SEED_USER_PASSWORD=
