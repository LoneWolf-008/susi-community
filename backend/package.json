{
  "name": "susi-community-backend",
  "version": "1.0.0",
  "description": "Backend API untuk SUSI Community - Platform penghubung kebutuhan digital komunitas dengan talenta IT",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node utils/migrate.js init",
    "db:migrate": "node utils/migrate.js migrate",
    "db:status": "node utils/migrate.js status",
    "db:reset": "node utils/migrate.js reset",
    "seed": "node utils/seed.js",
    "demo:reset": "node utils/migrate.js reset && node utils/seed.js --sync-kb",
    "demo:login": "node scripts/demo-login.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "eval:chatbot": "node tests/chatbot/runEval.js",
    "chat:retention": "node utils/chatRetention.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
